# Copie para .env SÓ para testar localmente (nunca suba o .env para o GitHub).
# Na hospedagem, cadastre estas variáveis no painel (Environment/Variables). Nunca coloque valores reais aqui.
BASE_URL=http://localhost:8000
# Atrás de proxy HTTPS da hospedagem (Northflank, Railway...): 1. Rodando direto na sua máquina: 0.
TRUST_PROXY=0
# --- Backup gratuito do banco (Supabase Storage). Sem disco persistente isto é OBRIGATÓRIO ---
BACKUP_SUPABASE_URL=
BACKUP_SUPABASE_KEY=
BACKUP_BUCKET=zenfi-backup
# --- WhatsApp Cloud API (Meta) ---
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NUMERO_PUBLICO=
# --- Assinatura (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# --- E-mail para "Esqueci minha senha" ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# --- Planos ---
TRIAL_DIAS=7
LIMITE_GRATIS_LANCAMENTOS=30
